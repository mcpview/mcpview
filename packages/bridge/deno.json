{
  "name": "@mcpview/bridge",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./adapters/network": "./src/adapters/network/mod.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/client/bridge.js",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts",
      "**/*.bench.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-net --allow-read src/ tests/",
    "check": "deno check src/mod.ts",
    "lint": "deno lint",
    "build:npm": "deno run -A scripts/build-npm.ts",
    "demo": "deno run --allow-net --allow-read --allow-env examples/demo-time/start.ts",
    "changelog:draft": "git -C ../.. cliff --config cliff.toml --tag-pattern '^bridge-v.*' --include-path 'packages/bridge/**' --unreleased",
    "release:check": "deno task check && deno task lint && deno task test",
    "release:tag": "deno run -A ../../scripts/release-tag.ts bridge"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@deno/dnt": "jsr:@deno/dnt@^0.41"
  },
  "lint": {
    "exclude": [
      "src/client/",
      "examples/",
      "scripts/"
    ]
  },
  "compilerOptions": {
    "strict": true
  }
}
