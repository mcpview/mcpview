{
  "name": "@mcpview/server",
  "version": "0.29.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "include": ["mod.ts", "src/**/*.ts", "README.md", "LICENSE"],
    "exclude": ["**/*_test.ts", "**/*.test.ts", "**/*.bench.ts"]
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run --no-check src/ api-surface_test.ts",
    "test:security": "deno test --allow-net --allow-read --allow-env --no-check src/http-security_test.ts",
    "test:http": "deno test --allow-net --allow-read --allow-env --no-check src/http-server_test.ts src/http-security_test.ts",
    "check": "deno check mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "changelog:draft": "git -C ../.. cliff --config cliff.toml --tag-pattern '^server-v.*' --include-path 'packages/server/**' --unreleased",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "release:check": "deno check mod.ts src/ api-surface_test.ts && deno task test && deno task publish:check",
    "release:tag": "deno run -A ../../scripts/release-tag.ts server"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@^2.3.1",
    "@modelcontextprotocol/ext-apps": "npm:@modelcontextprotocol/ext-apps@^2.0.3",
    "@std/assert": "jsr:@std/assert@^1",
    "ajv": "npm:ajv@^8.17.1",
    "ajv/dist/2020.js": "npm:ajv@^8.17.1/dist/2020.js",
    "hono": "npm:hono@^4",
    "hono/cors": "npm:hono@^4/cors",
    "jose": "npm:jose@^6.0.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@modelcontextprotocol/core": "npm:@modelcontextprotocol/core@^2.3.1",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@^2.3.1",
    "zod": "npm:zod@^4.2.0"
  }
}
