{
  "name": "@mcpview/contracts",
  "version": "0.2.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": ["**/*_test.ts"]
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test": "deno test --allow-read src/",
    "check": "deno check mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "changelog:draft": "git -C ../.. cliff --config cliff.toml --tag-pattern '^view-contracts-v.*' --include-path 'packages/view-contracts/**' --unreleased",
    "release:check": "deno task check && deno task lint && deno task test && deno task publish:check",
    "release:tag": "deno run -A ../../scripts/release-tag.ts view-contracts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "exclude": ["dist-node"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "esnext"]
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  }
}
