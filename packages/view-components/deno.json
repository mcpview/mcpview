{
  "name": "@mcpview/components",
  "version": "0.10.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./preact": "./preact.ts",
    "./preact/components": "./preact-components.ts",
    "./scaffold": "./scaffold.ts",
    "./surface": "./surface.ts",
    "./layout": "./layout.ts",
    "./fonts": "./fonts.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "preact.ts",
      "preact-components.ts",
      "scaffold.ts",
      "surface.ts",
      "layout.ts",
      "fonts.ts",
      "src/**/*.ts",
      "src/**/*.tsx",
      "README.md",
      "LICENSE"
    ],
    "exclude": ["**/*_test.ts", "**/*_test.tsx", "src/testing/**"]
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env src/ entries_test.ts preact_components_test.ts scaffold_test.ts",
    "check": "deno check mod.ts preact.ts preact-components.ts scaffold.ts surface.ts layout.ts fonts.ts scripts/fetch-fonts.ts",
    "fonts:fetch": "deno run --allow-net=fonts.googleapis.com,fonts.gstatic.com --allow-read --allow-write scripts/fetch-fonts.ts",
    "fonts:check": "deno run --allow-net=fonts.googleapis.com,fonts.gstatic.com --allow-read scripts/fetch-fonts.ts --check",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "changelog:draft": "git -C ../.. cliff --config cliff.toml --tag-pattern '^view-components-v.*' --include-path 'packages/view-components/**' --unreleased",
    "release:tag": "deno run -A ../../scripts/release-tag.ts view-components",
    "release:check": "deno task check && deno task lint && deno task test && deno task publish:check"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "exclude": ["dist-node"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "deno.window", "dom", "dom.iterable", "dom.asynciterable", "esnext"]
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.1.0",
    "preact": "npm:preact@^10.28.3"
  }
}
