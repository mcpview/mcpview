{
  "name": "@casys/mcp-bridge",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./adapters/network": "./adapters-network.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "adapters-network.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts"
    ]
  },
  "tasks": {
    "build:npm": "deno run -A ../../../scripts/build-alias-npm.ts --target=@mcpview/bridge --cjs",
    "test": "deno test --allow-read --allow-env mod_test.ts",
    "check": "deno check mod.ts adapters-network.ts mod_test.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "release:check": "deno task check && deno task lint && deno task test && deno task publish:check",
    "release:tag": "deno run -A ../../../scripts/release-tag.ts mcp-bridge"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "exclude": [
      "dist-node"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@mcpview/bridge": "jsr:@mcpview/bridge@^0.4.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  }
}
