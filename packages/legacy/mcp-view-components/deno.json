{
  "name": "@casys/mcp-view-components",
  "version": "0.12.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./preact": "./preact.ts",
    "./preact/components": "./preact-components.ts",
    "./scaffold": "./scaffold.ts",
    "./surface": "./surface.ts",
    "./layout": "./layout.ts",
    "./fonts": "./fonts.ts",
    "./preact/context": "./preact-context.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "preact.ts",
      "preact-components.ts",
      "preact-context.ts",
      "scaffold.ts",
      "surface.ts",
      "layout.ts",
      "fonts.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts"
    ]
  },
  "tasks": {
    "build:npm": "deno run -A ../../../scripts/build-alias-npm.ts --target=@mcpview/components --cjs --jsr-only=./scaffold",
    "test": "deno test --allow-read --allow-env mod_test.ts",
    "check": "deno check preact-context.ts mod.ts preact.ts preact-components.ts scaffold.ts surface.ts layout.ts fonts.ts mod_test.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "release:check": "deno task check && deno task lint && deno task test && deno task publish:check",
    "release:tag": "deno run -A ../../../scripts/release-tag.ts mcp-view-components"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "exclude": [
      "dist-node"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "deno.window",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "imports": {
    "@mcpview/components": "jsr:@mcpview/components@^0.12.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  }
}
