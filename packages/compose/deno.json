{
  "name": "@mcpview/compose",
  "version": "0.10.0",
  "exports": {
    ".": "./mod.ts",
    "./core": "./src/core/mod.ts",
    "./sdk": "./src/sdk/mod.ts",
    "./host": "./src/host/mod.ts",
    "./runtime": "./src/runtime/mod.ts",
    "./deploy": "./src/deploy/mod.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "tests/",
      "_reference/"
    ]
  },
  "tasks": {
    "build:npm": "deno run -A scripts/build-npm.ts",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "test": "deno test --allow-read --allow-write --allow-run --allow-net --allow-env src/ stubs/tests/",
    "test:unit": "deno test --allow-read --allow-write src/",
    "test:stubs": "deno test --allow-read --allow-write --allow-run --allow-net --allow-env stubs/tests/",
    "test:watch": "deno test --watch --allow-read --allow-write src/",
    "demo": "deno run --allow-all stubs/demo.ts",
    "check": "deno check mod.ts stubs/shared.ts stubs/stub-chart/server.ts stubs/stub-detail/server.ts stubs/stub-filter/server.ts stubs/stub-list/server.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "changelog:draft": "git -C ../.. cliff --config cliff.toml --tag-pattern '^compose-v.*' --include-path 'packages/compose/**' --unreleased",
    "release:check": "deno task check && deno task lint && deno task test",
    "release:tag": "deno run -A ../../scripts/release-tag.ts compose"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.41",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@modelcontextprotocol/ext-apps": "npm:@modelcontextprotocol/ext-apps@^2.0.3",
    "ajv": "npm:ajv@^8.17.1",
    "hono": "npm:hono@^4",
    "hono/cors": "npm:hono@^4/cors",
    "jose": "npm:jose@^6.0.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@modelcontextprotocol/core": "npm:@modelcontextprotocol/core@^2.3.1",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@^2.3.1",
    "zod": "npm:zod@^4.2.0"
  }
}
